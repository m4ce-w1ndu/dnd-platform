# Tavolo Virtuale: solo Python standard, nessuna dipendenza.
# Le avventure NON sono nell'immagine: stanno nel volume /app/avventure (pacchetti .zip estratti).
FROM docker.io/library/python:3.13-alpine
WORKDIR /app
COPY server.py ./
COPY web ./web
RUN adduser -D -H -u 1000 tavolo \
 && mkdir -p /app/dati /app/avventure \
 && chown -R tavolo:tavolo /app/dati /app/avventure
USER tavolo
ENV PORT=8000 PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK --interval=60s --timeout=5s CMD wget -qO /dev/null http://127.0.0.1:8000/api/info || exit 1
CMD ["python3", "server.py"]
